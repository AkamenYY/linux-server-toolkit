# --- Артефакты выполнения скриптов -----------------------------------------
*.log
logs/
tmp/
*.tmp
*.bak

# --- Резервные копии, создаваемые backup.sh --------------------------------
backups/
*.tar.gz
*.tar.zst

# --- Локальные секреты и переопределения конфигурации ----------------------
# ВАЖНО: реальные значения (пароли, токены, адреса хостов) никогда не
# попадают в репозиторий. В git хранится только config/toolkit.conf.example
*.env
.env.local
config/toolkit.local.conf
secrets/
*.pem
*.key
id_rsa*

# --- Служебные файлы ОС и редакторов ---------------------------------------
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/
