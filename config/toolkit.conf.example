# ---------------------------------------------------------------------------
# linux-server-toolkit — основной файл конфигурации
#
# Скопируйте этот файл в config/toolkit.conf и отредактируйте под своё
# окружение. Сам toolkit.conf добавлен в .gitignore и в репозиторий не
# попадает: в нём могут оказаться внутренние адреса и пути.
#
# Формат: KEY="value". Файл подключается через `source`, поэтому
# посторонних команд здесь быть не должно.
# ---------------------------------------------------------------------------

# --- Общие параметры -------------------------------------------------------

# Каталог, в который пишутся журналы работы самого toolkit
TOOLKIT_LOG_DIR="/var/log/linux-server-toolkit"

# Уровень детализации: DEBUG | INFO | WARN | ERROR
LOG_LEVEL="INFO"

# --- Резервное копирование (backup.sh) -------------------------------------

# Каталоги, которые нужно бэкапить. Разделитель — пробел.
BACKUP_SOURCES="/etc /home /var/www"

# Куда складывать архивы
BACKUP_DEST="/var/backups/toolkit"

# Сколько дней хранить архивы. Всё, что старше, удаляется.
# ВНИМАНИЕ: значение 0 означало бы удаление свежих копий, поэтому
# скрипт обязан отвергать значения меньше 1.
BACKUP_RETENTION_DAYS="14"

# --- Проверка здоровья системы (healthcheck.sh) ----------------------------

# Порог заполненности диска в процентах, после которого выдаётся WARNING
DISK_USAGE_THRESHOLD="85"

# Порог использования оперативной памяти в процентах
MEMORY_USAGE_THRESHOLD="90"

# Средняя загрузка (load average за 5 минут) на одно ядро
LOAD_AVG_THRESHOLD="2.0"

# Службы, которые обязаны быть запущены. Разделитель — пробел.
CRITICAL_SERVICES="sshd cron"
